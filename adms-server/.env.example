# HTTP server port (Secureye machine will connect to <THIS_PC_LAN_IP>:8080)
PORT=8080
HOST=0.0.0.0

# Optional: Your Secureye machine's LAN IP (used by `npm run probe` and LAN Diagnostics)
SECUREYE_DEVICE_IP=192.168.1.101

# Database:
# - Leave DATABASE_URL blank to use zero-config built-in SQLite at SQLITE_PATH (recommended for Gym PC)
# - Or set DATABASE_URL=postgresql://... for production PostgreSQL
DATABASE_URL=
SQLITE_PATH=./data/adms.db

# Device Online/Offline threshold in seconds (device is Online if heartbeat arrived within this window)
DEVICE_ONLINE_THRESHOLD_SEC=120

# ADMS Handshake Configuration
# TimeZone offset sent to the device (5.5 = India IST, 0 = UTC)
ADMS_TIMEZONE=5.5
ADMS_ERROR_DELAY=60
ADMS_DELAY=10
ADMS_TRANS_TIMES=00:00;14:05
ADMS_TRANS_INTERVAL=1
ADMS_TRANS_FLAG=1111000000
ADMS_REALTIME=1
ADMS_ENCRYPT=0

# Optional: Protect REST API endpoints (/api/*) with a Bearer token or x-api-key
# Leave blank for local gym PC use
API_AUTH_TOKEN=

# Live Sync into Dream Gym Firebase Firestore (gym001-50a97):
# Simply drop your downloaded Firebase `serviceAccountKey.json` into this `adms-server/` folder
# (it is auto-detected!), OR specify a custom path/JSON below:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=gym001-50a97
