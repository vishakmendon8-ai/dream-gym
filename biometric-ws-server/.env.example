# Google Cloud Run injects PORT automatically (default 8080)
PORT=8080
HOST=0.0.0.0

# Existing Firebase project ID
FIREBASE_PROJECT_ID=gym001-50a97

# On Cloud Run, Application Default Credentials (ADC) are used automatically (K_SERVICE).
# For local testing or Secret Manager injection, optionally provide:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional Admin API token (store in Google Secret Manager as BIOMETRIC_API_SECRET)
BIOMETRIC_API_SECRET=

# Timezone offset (hours) used when Secureye timestamps omit timezone (5.5 = IST)
DEVICE_TIMEZONE_OFFSET=5.5

# Registered Secureye device baseline metadata
SECUREYE_SERIAL_NUMBER=102026020002110
SECUREYE_CLOUD_ID=102026020002110
SECUREYE_UNIQUE_ID=BD77B4BE-3765DCD
SECUREYE_LOCAL_IP=192.168.1.101
SECUREYE_TCP_PORT=5005
SECUREYE_P2P_IP=54.187.2.68
SECUREYE_P2P_PORT=4000
