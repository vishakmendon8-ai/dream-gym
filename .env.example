# Optional deploy-time overrides for the built-in Dream Gym biometric backend.
# Defaults are already compiled into src/config/biometricConfig.ts so gym clients
# never need to enter or maintain server URLs, WebSocket endpoints, or secrets.

VITE_BIOMETRIC_WS_BACKEND_URL=https://dream-gym-1.onrender.com
# VITE_BIOMETRIC_WS_URL=wss://dream-gym-1.onrender.com/biometric
# VITE_BIOMETRIC_API_SECRET=
# VITE_BIOMETRIC_DEVICE_NAME=Main Entrance Secureye Terminal
# VITE_BIOMETRIC_DEVICE_SN=102026020002110
# VITE_BIOMETRIC_P2P_ID=BD77B4BE-3765DCD
# VITE_BIOMETRIC_DEVICE_IP=192.168.1.101
